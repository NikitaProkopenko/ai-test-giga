# Ключ авторизации GigaChat API
# Получить в личном кабинете: https://developers.sber.ru/studio/
GIGACHAT_CREDENTIALS=your_base64_encoded_credentials_here

# Scope: GIGACHAT_API_PERS — для физ. лиц, GIGACHAT_API_B2B — для бизнеса
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat (GigaChat, GigaChat-Plus, GigaChat-Pro)
GIGACHAT_MODEL=GigaChat
